# Knowledge base and vector index
RAG_DOCS_DIR=knowledge
RAG_INDEX_DIR=.rag_index
RAG_EMBEDDING_MODEL=local-hash-v1
RAG_EMBEDDING_CACHE_DIR=.cache/fastembed
RAG_TOP_K=4
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120

# Codex CLI. Leave CODEX_MODEL empty to inherit ~/.codex/config.toml.
CODEX_BINARY=codex
CODEX_MODEL=
CODEX_HOME=~/.codex
CODEX_TIMEOUT_SECONDS=180
CODEX_REASONING_EFFORT=medium
